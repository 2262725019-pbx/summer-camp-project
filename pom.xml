<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.summercamp</groupId>
    <artifactId>summer-camp-project</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Summer Camp Project</name>
    <description>Java starter project for the summer camp team.</description>

    <properties>
        <java.version>21</java.version>
        <wechat-ilink-sdk.version>2.3.3</wechat-ilink-sdk.version>
        <silk-codec.version>0.0.5</silk-codec.version>
        <edge-tts.version>1.3.3</edge-tts.version>
        <zxing.version>3.5.4</zxing.version>
        <exp4j.version>0.4.8</exp4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.lith0924</groupId>
            <artifactId>wechat-ilink-sdk</artifactId>
            <version>${wechat-ilink-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.kasukusakura</groupId>
            <artifactId>silk-codec</artifactId>
            <version>${silk-codec.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.whitemagic2014</groupId>
            <artifactId>tts-edge-java</artifactId>
            <version>${edge-tts.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>net.objecthunter</groupId>
            <artifactId>exp4j</artifactId>
            <version>${exp4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
