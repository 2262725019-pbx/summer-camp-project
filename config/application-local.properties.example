# 复制为 application-local.properties，并填写自己的智谱 API Key。
ai.zhipu.api-key=PASTE_YOUR_NEW_ZHIPU_API_KEY_HERE

bot.enabled=true
bot.qr-code-auto-open=true
bot.qr-code-path=runtime/wechat-login-qr.png
bot.image-max-bytes=10485760
bot.voice-max-bytes=26214400
bot.voice-max-duration=30s
bot.voice-reply-mode=file
bot.poll-retry-delay=5s

# 计算结果展示页。手机与电脑在同一局域网时，留空即可自动识别电脑 IP。
# 如果自动识别的地址不正确，可填写例如：http://192.168.1.100:8080
result-page.public-base-url=
result-page.port=8080
result-page.ttl=30m

# 项目 FAQ 关键词 RAG。改为 false 可进行关闭 RAG 的对比测试。
rag.enabled=true
rag.top-k=3
rag.min-score=2
rag.max-context-chars=2500

# 大学生智能健康生活规划 Agent。
agent.health.enabled=true
agent.health.pending-ttl=30m
agent.health.generate-cover=false

# Agent 状态保存在本地 SQLite，程序重启后仍可续跑任务和恢复提醒。
agent.persistence.enabled=true
agent.persistence.database-path=runtime/agent-state.db

# 性能优化；封面不是主流程必需，可设为 false 以减少等待和图片调用。
agent.optimization.cache-enabled=true
agent.optimization.weather-cache-ttl=10m
agent.optimization.rag-cache-ttl=30m
agent.optimization.cache-max-entries=200
agent.optimization.max-rag-prompt-chars=1200
agent.optimization.max-history-messages=6
agent.optimization.max-history-chars=1600

# 用户仍需在微信发送“开启每日健康提醒 07:30”才会真正订阅。
agent.health.reminder.enabled=true
agent.health.reminder.scan-interval=30s
agent.health.reminder.plan-ttl=14d
agent.health.reminder.zone-id=Asia/Shanghai

ai.zhipu.base-url=https://open.bigmodel.cn/api/paas/v4
ai.zhipu.chat-api-path=/chat/completions
ai.zhipu.image-api-path=/images/generations
ai.zhipu.asr-api-path=/audio/transcriptions
ai.zhipu.text-model=glm-4.7-flash
ai.zhipu.text-fallback-models=glm-4-flash-250414
ai.zhipu.vision-model=glm-4.6v-flash
ai.zhipu.vision-fallback-models=glm-4.1v-thinking-flash,glm-4v-flash
ai.zhipu.image-model=cogview-3-flash
ai.zhipu.image-size=1024x1024
ai.zhipu.asr-model=glm-asr-2512
ai.zhipu.timeout=60s

# 高德开放平台中申请“Web 服务”类型的 Key。
weather.amap.api-key=PASTE_YOUR_AMAP_WEB_SERVICE_KEY_HERE
weather.amap.base-url=https://restapi.amap.com
weather.amap.timeout=10s

# 免费的 Microsoft Edge 在线朗读服务，不需要 API Key。
speech.edge-tts.voice=zh-CN-XiaoxiaoNeural
speech.edge-tts.rate=+0%
speech.edge-tts.pitch=+0Hz
speech.edge-tts.volume=+0%
speech.edge-tts.connect-timeout=20s
